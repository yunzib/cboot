/**
 * @file orm.postgres.cppm
 * @brief PostgreSQL 驱动契约组件
 *
 * 本组件只提供 PostgreSQL 特有部分：
 *   - PgProps：连接配置（前缀 db）
 *   - PgDialect：双引号、$n 占位符、RETURNING、ILIKE、IDENTITY 类型
 *   - PgDataSource：libpq 连接池
 *   - postgres_component：依赖通用 orm_component
 *
 * libpq 头文件不进入模块接口；连接池和语句细节在 src/postgres.cpp。
 */
export module cboot.orm.postgres;

import std;
import cboot.core.annotations;   // Bean / PostConstruct / PreDestroy / Config
import cboot.core.context;       // health_registry
import cboot.meta.reflect;       // type_list
export import cboot.orm;         // 通用 ORM 词汇（含 dialect / DataSource）
import cboot.orm.driver;

export namespace orm {

/**
 * @brief PostgreSQL 连接配置（前缀 db）
 *
 * password：
 *   - 留空：交给 libpq 读取 PGPASSWORD 环境变量
 *   - 写 "${PGPASSWORD}"：由 config 的 ${ENV} 展开；未展开时同样回退到 libpq
 *   - 直接写值：使用该值
 *
 * 密码不会出现在错误信息/日志里。
 */
struct [[=Config{"db"}]] PgProps {
    std::string url{"postgresql://localhost/postgres"};
    std::string user;
    std::string password;
    std::string sslmode{"prefer"};
    int pool_size{4};
    int connect_timeout_s{5};
    int acquire_timeout_ms{5000};
};

/**
 * @brief PostgreSQL SQL 方言
 *
 * 引用：双引号；占位符：$1..$n；自增：IDENTITY；支持 RETURNING/ILIKE。
 */
class PgDialect final : public dialect {
public:
    std::string quote_identifier(std::string_view name) const override {
        std::string out;
        out.reserve(name.size() + 2);
        out.push_back('"');
        for (char c : name) {
            if (c == '"') out += "\"\"";
            else out.push_back(c);
        }
        out.push_back('"');
        return out;
    }

    std::string placeholder(std::size_t index) const override {
        return "$" + std::to_string(index);
    }

    std::string type_name(sql_type type) const override {
        switch (type) {
        case sql_type::boolean: return "BOOLEAN";
        case sql_type::integer: return "INTEGER";
        case sql_type::big_integer: return "BIGINT";
        case sql_type::real: return "DOUBLE PRECISION";
        case sql_type::text: return "TEXT";
        }
        return "TEXT";
    }

    std::string identity_type(sql_type type) const override {
        return type_name(type) + " GENERATED BY DEFAULT AS IDENTITY";
    }

    std::string insert_default_values(std::string_view table) const override {
        return "INSERT INTO " + std::string(table) + " DEFAULT VALUES";
    }

    bool supports_returning() const override { return true; }
    bool supports_ilike() const override { return true; }
};

/** @brief 进程级 PostgreSQL 方言单例；PgDataSource 返回其引用 */
inline const dialect& pg_dialect() {
    static const PgDialect d;
    return d;
}

/**
 * @brief PostgreSQL 连接池 DataSource
 *
 * 公开接口只暴露 DataSource 语义；libpq 头文件不进入模块接口，
 * 这样消费者不需要 include libpq。
 */
class [[=Bean{}]] PgDataSource : public DataSource {
public:
    /**
     * @brief 构造但不立即连接
     *
     * 连接放在 open()（PostConstruct）里，便于 context 在全部配置
     * 就绪后统一启动，也便于测试直接控制生命周期。
     */
    PgDataSource(PgProps& cfg, health_registry& health);
    ~PgDataSource() override;

    /** @brief 建立连接池；失败抛 orm::error 并标记 health DOWN */
    [[=PostConstruct{}]] void open();

    /** @brief 关闭空闲连接；忙连接归还时销毁 */
    [[=PreDestroy{}]] void close();

    /** @brief 从池中租借一个连接；池满时按 acquire_timeout_ms 等待 */
    connection_lease acquire() override;

    /** @brief PostgreSQL 方言 */
    const orm::dialect& dialect() const override { return pg_dialect(); }

    struct impl;

private:
    std::unique_ptr<impl> impl_;
};

} // namespace orm

/**
 * @brief PostgreSQL 驱动契约组件描述符
 *
 * 选中后贡献 PgProps / PgDataSource，并通过依赖闭包带入
 * orm_component（EntityManager）。应用只需选择本组件。
 */
export struct postgres_component {
    static constexpr bean_name name{"orm.postgres"};
    using beans = type_list<orm::PgProps, orm::PgDataSource>;
    using dependencies = type_list<orm_component>;
};
